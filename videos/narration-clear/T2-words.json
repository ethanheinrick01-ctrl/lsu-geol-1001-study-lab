[{"start": 0.0, "end": 2.7, "text": " For the review, know the major divisions and their order.", "words": [{"start": 0.0, "end": 0.12, "word": " For"}, {"start": 0.12, "end": 0.22, "word": " the"}, {"start": 0.22, "end": 0.48, "word": " review,"}, {"start": 0.9, "end": 1.04, "word": " know"}, {"start": 1.04, "end": 1.2, "word": " the"}, {"start": 1.2, "end": 1.5, "word": " major"}, {"start": 1.5, "end": 1.8, "word": " divisions"}, {"start": 1.8, "end": 2.32, "word": " and"}, {"start": 2.32, "end": 2.44, "word": " their"}, {"start": 2.44, "end": 2.7, "word": " order."}]}, {"start": 3.38, "end": 6.4, "text": " Pre-Cambrian comes first and includes most of Earth's history.", "words": [{"start": 3.38, "end": 3.38, "word": " Pre"}, {"start": 3.38, "end": 3.8, "word": "-Cambrian"}, {"start": 3.8, "end": 4.06, "word": " comes"}, {"start": 4.06, "end": 4.36, "word": " first"}, {"start": 4.36, "end": 4.72, "word": " and"}, {"start": 4.72, "end": 5.0, "word": " includes"}, {"start": 5.0, "end": 5.56, "word": " most"}, {"start": 5.56, "end": 5.8, "word": " of"}, {"start": 5.8, "end": 6.08, "word": " Earth's"}, {"start": 6.08, "end": 6.4, "word": " history."}]}, {"start": 8.14, "end": 12.08, "text": " Next is the Paleozoic, with diverse life in the seas and expanding onto land.", "words": [{"start": 8.14, "end": 8.3, "word": " Next"}, {"start": 8.3, "end": 8.54, "word": " is"}, {"start": 8.54, "end": 8.66, "word": " the"}, {"start": 8.66, "end": 9.4, "word": " Paleozoic,"}, {"start": 9.62, "end": 9.68, "word": " with"}, {"start": 9.68, "end": 9.84, "word": " diverse"}, {"start": 9.84, "end": 10.28, "word": " life"}, {"start": 10.28, "end": 10.48, "word": " in"}, {"start": 10.48, "end": 10.58, "word": " the"}, {"start": 10.58, "end": 10.78, "word": " seas"}, {"start": 10.78, "end": 11.1, "word": " and"}, {"start": 11.1, "end": 11.42, "word": " expanding"}, {"start": 11.42, "end": 11.74, "word": " onto"}, {"start": 11.74, "end": 12.08, "word": " land."}]}, {"start": 12.86, "end"