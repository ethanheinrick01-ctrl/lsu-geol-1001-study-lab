[{"start": 0.0, "end": 4.04, "text": " Know the process is connecting igneous, sedimentary, and metamorphic rock.", "words": [{"start": 0.0, "end": 0.18, "word": " Know"}, {"start": 0.18, "end": 0.3, "word": " the"}, {"start": 0.3, "end": 0.62, "word": " process"}, {"start": 0.62, "end": 0.8, "word": " is"}, {"start": 0.8, "end": 1.12, "word": " connecting"}, {"start": 1.12, "end": 1.8, "word": " igneous,"}, {"start": 2.3, "end": 3.0, "word": " sedimentary,"}, {"start": 3.28, "end": 3.3, "word": " and"}, {"start": 3.3, "end": 3.84, "word": " metamorphic"}, {"start": 3.84, "end": 4.04, "word": " rock."}]}, {"start": 4.56, "end": 5.96, "text": " Weathering breaks rock down.", "words": [{"start": 4.56, "end": 5.04, "word": " Weathering"}, {"start": 5.04, "end": 5.34, "word": " breaks"}, {"start": 5.34, "end": 5.56, "word": " rock"}, {"start": 5.56, "end": 5.96, "word": " down."}]}, {"start": 6.62, "end": 8.34, "text": " Erosion and transport move the pieces.", "words": [{"start": 6.62, "end": 7.1, "word": " Erosion"}, {"start": 7.1, "end": 7.22, "word": " and"}, {"start": 7.22, "end": 7.6, "word": " transport"}, {"start": 7.6, "end": 7.9, "word": " move"}, {"start": 7.9, "end": 8.08, "word": " the"}, {"start": 8.08, "end": 8.34, "word": " pieces."}]}, {"start": 8.96, "end": 9.88, "text": " Deposition drops them.", "words": [{"start": 8.96, "end": 9.18, "word": " Deposition"}, {"start": 9.18, "end": 9.6, "word": " drops"}, {"start": 9.6, "end": 9.88, "word": " them."}]}, {"start": 10.44, "end": 11.6, "text": " Burial packs sediment together.", "words": [{"start": 10.44, "end": 10.6, "word": " Burial"}, {"start": 10.6, "end": 10.82, "word": " packs"}, {"start": 10.82, "end": 11.16, "word": " sediment"}, {"start": 11.16, "end": 11.6, "word": " together."}]}, {"start": 12.26, "end": 15.48, "text": " Compaction and cementation turn loose grains into sedimentary rock.", "words": [{"start": 12.26, "end": 12.64, "word": " Compaction"}, {"start": 12.64, "end": 12.84, "word": " 