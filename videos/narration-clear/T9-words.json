[{"start": 0.0, "end": 2.72, "text": " Vessicles are cavities made by gas bubbles in lava.", "words": [{"start": 0.0, "end": 0.46, "word": " Vessicles"}, {"start": 0.46, "end": 0.66, "word": " are"}, {"start": 0.66, "end": 1.1, "word": " cavities"}, {"start": 1.1, "end": 1.38, "word": " made"}, {"start": 1.38, "end": 1.58, "word": " by"}, {"start": 1.58, "end": 1.86, "word": " gas"}, {"start": 1.86, "end": 2.18, "word": " bubbles"}, {"start": 2.18, "end": 2.48, "word": " in"}, {"start": 2.48, "end": 2.72, "word": " lava."}]}, {"start": 3.38, "end": 5.76, "text": " As pressure falls, dissolved gas comes out of solution", "words": [{"start": 3.38, "end": 3.4, "word": " As"}, {"start": 3.4, "end": 3.6, "word": " pressure"}, {"start": 3.6, "end": 4.04, "word": " falls,"}, {"start": 4.26, "end": 4.4, "word": " dissolved"}, {"start": 4.4, "end": 4.88, "word": " gas"}, {"start": 4.88, "end": 5.24, "word": " comes"}, {"start": 5.24, "end": 5.44, "word": " out"}, {"start": 5.44, "end": 5.52, "word": " of"}, {"start": 5.52, "end": 5.76, "word": " solution"}]}, {"start": 5.76, "end": 7.32, "text": " and bubbles begin to grow.", "words": [{"start": 5.76, "end": 6.28, "word": " and"}, {"start": 6.28, "end": 6.52, "word": " bubbles"}, {"start": 6.52, "end": 6.92, "word": " begin"}, {"start": 6.92, "end": 7.08, "word": " to"}, {"start": 7.08, "end": 7.32, "word": " grow."}]}, {"start": 7.8, "end": 9.64, "text": " The review compares pumice and scoria.", "words": [{"start": 7.8, "end": 7.8, "word": " The"}, {"start": 7.8, "end": 7.98, "word": " review"}, {"start": 7.98, "end": 8.48, "word": " compares"}, {"start": 8.48, "end": 8.92, "word": " pumice"}, {"start": 8.92, "end": 9.26, "word": " and"}, {"start": 9.26, "end": 9.64, "word": " scoria."}]}, {"start": 10.34, "end": 13.18, "text": " Pumice commonly has many thin walled cavities and can float.", "words": [{"start": 10.34, "end": 10.6, "word": " Pumice"}, {"start": 10.6, "end": 10.84, "word": " commonly"}, {"start": 10.84, "end": 11.22, "word": " has"}, {"start": 11.22, "end": 11.44, "word": " many"}, {"start": 11.44, "end": 11.74, "word": " thin"}, {"start": 11.74, "end": 12.08, "word": " walled"}, {"start": 12.08, "end": 12.5, "word": " cavities"}, {"start": 12.5, "end": 12.8, "word": " and"}, {"start": 12.8, "end": 12.92, "word": " can"}, {"start": 12.92, "end": 13.18, "word": " float."}]}, {"start": 13.88, "end": 16.04, "text": " Scoria commonly has darker, thicker walls.", "words": [{"start": 13.88, "end": 14.08, "word": " Scoria"}, {"start": 14.08, "end": 14.56, "word": " commonly"}, {"start": 14.56, "end": 14.86, "word": " has"}, {"start": 14.86, "end": 15.1, "word": " darker,"}, {"start": 15.42, "end": 15.72, "word": " thicker"}, {"start": 15.72, "end": 16.04, "word": " walls."}]}, {"start": 17.0, "end": 18.04, "text": " Their compositions differ.", "words": [{"start": 17.0, "end": 17.02, "word": " Their"}, {"start": 17.02, "end": 17.3, "word": " compositions"}, {"start": 17.3, "end": 18.04, "word": " differ."}]}, {"start": 18.8, "end": 20.3, "text": " Cooling preserves the bubbles as holes.", "words": [{"start": 18.8, "end": 19.0, "word": " Cooling"}, {"start": 19.0, "end": 19.2, "word": " preserves"}, {"start": 19.2, "end": 19.58, "word": " the"}, {"start": 19.58, "end": 19.78, "word": " bubbles"}, {"start": 19.78, "end": 20.06, "word": " as"}, {"start": 20.06, "end": 20.3, "word": " holes."}]}, {"start": 20.98, "end": 22.54, "text": " These are vesicles, not crystals.", "words": [{"start": 20.98, "end": 21.04, "word": " These"}, {"start": 21.04, "end": 21.18, "word": " are"}, {"start": 21.18, "end": 21.62, "word": " vesicles,"}, {"start": 22.2, "end": 22.32, "word": " not"}, {"start": 22.32, "end": 22.54, "word": " crystals."}]}]